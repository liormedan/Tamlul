{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tamlul",
  "version": "0.1.0",
  "identifier": "com.liormedan.tamlul",
  "build": {
    "frontendDist": "../app/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "תמלול בעברית",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
