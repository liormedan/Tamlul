; Hebrew strings for Tauri's NSIS installer (bundle.windows.nsis.customLanguageFiles).

LangString addOrReinstall ${LANG_HEBREW} "הוסף רכיבים או התקן מחדש"

LangString alreadyInstalled ${LANG_HEBREW} "כבר מותקן"

LangString alreadyInstalledLong ${LANG_HEBREW} "${PRODUCTNAME} ${VERSION} כבר מותקן. בחר מה לעשות ולחץ על הבא כדי להמשיך."

LangString appRunning ${LANG_HEBREW} "${PRODUCTNAME} פתוח. סגור אותו ונסה שוב."

LangString appRunningOkKill ${LANG_HEBREW} "${PRODUCTNAME} פתוח.$\nלחץ על אישור כדי לסגור אותו"

LangString chooseMaintenanceOption ${LANG_HEBREW} "בחר את פעולת התחזוקה."

LangString chooseHowToInstall ${LANG_HEBREW} "בחר איך להתקין את ${PRODUCTNAME}."

LangString createDesktop ${LANG_HEBREW} "צור קיצור דרך בשולחן העבודה"

LangString dontUninstall ${LANG_HEBREW} "אל תסיר"

LangString dontUninstallDowngrade ${LANG_HEBREW} "אל תסיר (במתקין הזה אי אפשר להתקין גרסה ישנה יותר בלי להסיר קודם)"

LangString failedToKillApp ${LANG_HEBREW} "לא הצלחתי לסגור את ${PRODUCTNAME}. סגור אותו ונסה שוב"

LangString newerVersionInstalled ${LANG_HEBREW} "גרסה חדשה יותר של ${PRODUCTNAME} כבר מותקנת. לא מומלץ להתקין גרסה ישנה יותר. אם בכל זאת רוצים, עדיף להסיר קודם את הגרסה הנוכחית. בחר מה לעשות ולחץ על הבא כדי להמשיך."

LangString older ${LANG_HEBREW} "ישנה יותר"

LangString olderOrUnknownVersionInstalled ${LANG_HEBREW} "גרסה $R4 של ${PRODUCTNAME} מותקנת במחשב. מומלץ להסיר אותה לפני ההתקנה. בחר מה לעשות ולחץ על הבא כדי להמשיך."

LangString silentDowngrades ${LANG_HEBREW} "במתקין הזה אי אפשר להתקין גרסה ישנה יותר, ולכן ההתקנה השקטה נעצרה. השתמש במתקין הרגיל.$\n"

LangString unableToUninstall ${LANG_HEBREW} "לא ניתן להסיר את ההתקנה."

LangString uninstallApp ${LANG_HEBREW} "הסר את ${PRODUCTNAME}"

LangString uninstallBeforeInstalling ${LANG_HEBREW} "הסר לפני ההתקנה"

LangString unknown ${LANG_HEBREW} "לא ידועה"

LangString deleteAppData ${LANG_HEBREW} "מחק גם את הפרויקטים, ההגדרות ומנוע התמלול שהורד (כ-7GB)"

