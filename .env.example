# ==========================================================
#  תמלול בעברית – הגדרות סודיות (קובץ .env)
# ==========================================================
#  הדבק את מפתח ה-API של Claude אחרי סימן השווה, בלי רווחים ובלי מרכאות.
#  המפתח מתחיל ב- sk-ant-
#  מקבלים אותו בחשבון המפתחים: https://platform.claude.com/settings/keys
#  קרדיטים קונים כאן:          https://platform.claude.com/settings/billing
#
#  אחרי השמירה (Ctrl+S) – אין צורך להפעיל מחדש, העוזר יקרא את המפתח מיד.
#  חשוב: לא לשלוח את הקובץ הזה לאף אחד – מי שיש לו את המפתח משתמש בקרדיט שלך.
# ==========================================================

ANTHROPIC_API_KEY=

# מודל (לא חובה). אפשרויות:
#   claude-sonnet-5-5   מומלץ לעברית (ברירת מחדל)
#   claude-haiku-5-5    מהיר וזול
#   claude-opus-5-5     הכי חזק
# כדי לבחור מודל, הורד את הסימן # מתחילת השורה הבאה:
# TAMLUL_AI_MODEL=claude-sonnet-5-5
